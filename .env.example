# 모두 선택 사항입니다. 비워 두면 인증 없는 경로(RSS, oEmbed 등)로 동작합니다.
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 공유하지 마세요.

# Reddit: https://www.reddit.com/prefs/apps 에서 "script" 앱 생성
#   있으면 점수·댓글 수를 받고, 검색 API를 쓰며, 속도 제한이 넉넉해집니다.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X: developer.x.com 의 Bearer Token (최근 검색은 유료 요금제 필요)
#   없으면 URL로 넣은 게시물만 fxtwitter(비공식 공개 API)로 받아옵니다.
X_BEARER_TOKEN=

# Threads: Meta 개발자 앱의 Threads 사용자 액세스 토큰 (threads_keyword_search 권한)
#   없으면 URL로 넣은 게시물만 공개 oEmbed로 받아옵니다.
THREADS_ACCESS_TOKEN=

# Instagram: Meta 앱 토큰 "앱ID|클라이언트토큰" (oEmbed Read 기능)
#   없으면 Instagram 게시물은 링크만 저장됩니다.
INSTAGRAM_APP_TOKEN=
